# =============================================================================
# OpenStudio Server — Docker Compose Environment Template
# =============================================================================
# Copy this file to .env and customize for your deployment:
#
#   cp .env.example .env
#
# Docker Compose loads .env automatically from the project directory.
# Do NOT commit your .env — it contains deployment-specific values.
# =============================================================================

# ── Standard development defaults ──────────────────────────────────────────
REDIS_PASSWORD=openstudio
REDIS_URL=redis://:openstudio@queue:6379
MONGO_USER=openstudio
MONGO_PASSWORD=openstudio
MONGO_MEM=209715200
SECRET_KEY_BASE=replace-with-your-own-secret-key-base

# ── Nomad External Batch ───────────────────────────────────────────────────
# SSH host for the rsync bridge to the nomad-server.
# This is the floating IP of the nomad-server OpenStack instance.
OS_SERVER_NOMAD_SSH_HOST=ubuntu@<NOMAD_SERVER_FLOATING_IP>

# Nomad HTTP API address (reachable from within the Docker container).
# This is the floating IP of the nomad-server, port 4646.
NOMAD_ADDR=http://<NOMAD_SERVER_FLOATING_IP>:4646
